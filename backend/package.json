{
  "name": "califnco-backend",
  "version": "1.0.0",
  "description": "Califnco Secure Express Backend for Render & Razorpay Test Mode Integration",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "test:payments": "npm run build && node dist/test/payment.test.js",
    "test:automation": "npm run build && node dist/test/automation.test.js",
    "test": "npm run build && node dist/test/payment.test.js && node dist/test/automation.test.js",
    "vault:update": "ts-node src/scripts/updateVaultToken.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^13.1.0",
    "node-cron": "^4.6.0",
    "razorpay": "^2.9.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^20.17.10",
    "@types/node-cron": "^3.0.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "private": true
}
