# Califnco Render Backend Environment Configuration (.env.example)
# DO NOT COMMIT REAL SECRETS OR SERVICE ACCOUNT CREDENTIALS

PORT=8080
NODE_ENV=development

# Razorpay Test Mode Credentials (obtained from Razorpay Dashboard -> Settings -> API Keys)
# Key ID begins with "rzp_test_" for test mode
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourTestKeySecretHere

# Firebase Project Configuration (Firebase Spark Free Tier project)
FIREBASE_PROJECT_ID=califnco-app-f2b7c

# Firebase Admin SDK Service Account Credentials (JSON string or individual fields on Render)
# Generated in Firebase Console -> Project Settings -> Service Accounts -> Generate Private Key
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@califnco-app-f2b7c.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Allowed CORS Origins (e.g. mobile apps, local testing, or admin web)
CORS_ORIGIN=*
