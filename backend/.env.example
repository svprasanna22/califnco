# Califnco Render Backend Environment Configuration (.env.example)
# DO NOT COMMIT REAL SECRETS OR SERVICE ACCOUNT CREDENTIALS

PORT=8080
NODE_ENV=development

# Razorpay Test Mode Credentials (obtained from Razorpay Dashboard -> Settings -> API Keys)
# Key ID begins with "rzp_test_" for test mode
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourTestKeySecretHere

# Firebase Project Configuration (Firebase Spark Free Tier project)
FIREBASE_PROJECT_ID=califnco-app-f2b7c

# Firebase Admin SDK Service Account Credentials (JSON string or individual fields on Render)
# Generated in Firebase Console -> Project Settings -> Service Accounts -> Generate Private Key
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@califnco-app-f2b7c.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Allowed CORS Origins (e.g. mobile apps, local testing, or admin web)
CORS_ORIGIN=*

# ==============================================================================
# AI & INSTAGRAM AUTOMATION (Zero-Cost / Free-Tier Architecture)
# ==============================================================================

# 1. Instagram Graph / Instagram Login API
# Numeric Business Account ID (or leave blank/set 'me' for automatic resolution with Instagram Login)
INSTAGRAM_ACCOUNT_ID=
# Long-Lived Instagram/Meta Access Token (60-day validity)
INSTAGRAM_ACCESS_TOKEN=
# Optional custom API base URL (default auto-selects graph.instagram.com or graph.facebook.com)
INSTAGRAM_API_BASE_URL=https://graph.instagram.com/v21.0
# Set to 'true' to execute visual + caption pipeline without sending live posts to Instagram
INSTAGRAM_DRY_RUN=true

# 2. Cloudinary Image CDN (Cloud Name: oxeow2gv)
CLOUDINARY_CLOUD_NAME=oxeow2gv
# Option A: Unsigned Upload Preset (recommended: zero secret credentials required)
CLOUDINARY_UPLOAD_PRESET=
# Option B: Signed Upload (API Key & Secret)
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 3. AI Marketing Copy Providers (Free Tier)
# Google Gemini 1.5 Flash (15 RPM / 1500 RPD free): https://aistudio.google.com
GEMINI_API_KEY=
# Optional Groq fallback (30 RPM free): https://console.groq.com
GROQ_API_KEY=

# 4. AI Image Generation (FLUX)
# Optional Hugging Face token (Pollinations FLUX fallback works with zero tokens):
HF_TOKEN=

# 5. Scheduling & Security
# Cryptographically strong secret (min 16 chars) required for GitHub Actions cloud cron
# Generate via: openssl rand -hex 24
AUTOMATION_CRON_SECRET=
# Timezone for daily 10:00 AM IST scheduling
AUTOMATION_TIMEZONE=Asia/Kolkata
AUTOMATION_SCHEDULE_CRON="0 10 * * *"
# Keep false by default so GitHub Actions is the single primary cloud scheduler
ENABLE_IN_PROCESS_CRON=false

# 6. Encrypted Server Token Vault (AES-256-GCM)
# Cryptographically random master key (min 32 chars) for encrypting refreshed tokens in Firestore
# Generate via: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=
