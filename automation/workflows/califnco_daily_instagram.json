{
  "name": "Califnco Daily AI Instagram Product Posting",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 10 * * *"
            }
          ]
        }
      },
      "id": "schedule-trigger-1",
      "name": "Daily at 10:00 AM IST",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "trigger-daily-post",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger-1",
      "name": "Manual Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        480
      ],
      "webhookId": "califnco-daily-post-webhook"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CALIFNCO_BACKEND_URL || 'https://califnco-backend.onrender.com' }}/api/automation/trigger-daily-post",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-automation-key",
              "value": "={{ $env.AUTOMATION_CRON_SECRET || 'califnco_auto_secret_2026' }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "force",
              "value": false
            },
            {
              "name": "isManualTrigger",
              "value": false
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "id": "http-trigger-backend",
      "name": "Trigger Califnco AI Instagram Engine",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        380
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.status }}",
              "value2": "success"
            }
          ]
        }
      },
      "id": "if-success",
      "name": "Check Execution Status",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        720,
        380
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "respond-webhook",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        960,
        480
      ]
    }
  ],
  "connections": {
    "Daily at 10:00 AM IST": {
      "main": [
        [
          {
            "node": "Trigger Califnco AI Instagram Engine",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual Webhook Trigger": {
      "main": [
        [
          {
            "node": "Trigger Califnco AI Instagram Engine",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger Califnco AI Instagram Engine": {
      "main": [
        [
          {
            "node": "Check Execution Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Execution Status": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata",
    "callerPolicy": "workflowsFromSameOwner"
  }
}
